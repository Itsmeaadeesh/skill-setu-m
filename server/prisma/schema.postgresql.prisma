datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String         @id @default(uuid())
  supabaseUid     String?        @unique
  email           String         @unique
  password        String?
  name            String
  role            String         @default("learner") // "learner" or "admin"
  avatar          String?
  targetTrackId   String?
  targetTrack     Track?         @relation(fields: [targetTrackId], references: [id], onDelete: SetNull)
  hasOnboarded    Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  skillProfiles   SkillProfile[]
  quizAttempts    QuizAttempt[]
  quizzesCreated  Quiz[]         @relation("UserCreatedQuizzes")
}

model Track {
  id              String             @id @default(uuid())
  name            String             @unique
  slug            String             @unique
  description     String
  icon            String             @default("Code")
  color           String             @default("indigo")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  users           User[]
  requirements    TrackRequirement[]
  courses         Course[]
  quizzes         Quiz[]
}

model Skill {
  id              String             @id @default(uuid())
  name            String             @unique
  slug            String             @unique
  category        String             // Frontend, Backend, Data, Cloud, CS
  description     String?
  icon            String             @default("Zap")
  createdAt       DateTime           @default(now())

  requirements    TrackRequirement[]
  skillProfiles   SkillProfile[]
  courses         Course[]
  quizzes         Quiz[]
}

model TrackRequirement {
  id            String   @id @default(uuid())
  trackId       String
  skillId       String
  requiredLevel Int      @default(3) // 1 to 5 scale
  track         Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([trackId, skillId])
}

model SkillProfile {
  id             String   @id @default(uuid())
  userId         String
  skillId        String
  level          Int      @default(1) // 1 to 5 scale
  source         String   @default("self-rated") // "quiz" or "self-rated"
  lastAssessedAt DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill          Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Course {
  id            String   @id @default(uuid())
  title         String
  description   String
  skillId       String
  trackId       String?
  difficulty    String   @default("foundational") // "foundational", "intermediate", "advanced"
  durationHours Int      @default(10)
  provider      String   @default("Skill Setu Academy")
  rating        Float    @default(4.8)
  thumbnail     String?
  url           String?
  createdAt     DateTime @default(now())
  
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  track         Track?   @relation(fields: [trackId], references: [id], onDelete: SetNull)
}

model Quiz {
  id                String         @id @default(uuid())
  title             String
  description       String?
  trackId           String?
  skillId           String?
  sourceFileUrl     String?
  sourceFilename    String?
  sourceText        String?
  isBaseline        Boolean        @default(false)
  createdById       String?
  timeLimitMinutes  Int            @default(15)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  track             Track?         @relation(fields: [trackId], references: [id], onDelete: SetNull)
  skill             Skill?         @relation(fields: [skillId], references: [id], onDelete: SetNull)
  createdBy         User?          @relation("UserCreatedQuizzes", fields: [createdById], references: [id], onDelete: SetNull)
  questions         QuizQuestion[]
  attempts          QuizAttempt[]
}

model QuizQuestion {
  id             String   @id @default(uuid())
  quizId         String
  question       String
  options        String   // JSON string of string[4]
  correct_option Int      // 0, 1, 2, or 3
  explanation    String
  difficulty     String   @default("intermediate") // "foundational", "intermediate", "advanced"
  createdAt      DateTime @default(now())

  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id             String   @id @default(uuid())
  userId         String
  quizId         String
  score          Int      @default(0)
  totalQuestions Int      @default(0)
  percentage     Float    @default(0.0)
  passed         Boolean  @default(false)
  answersJson    String   // JSON string of answers detail
  timestamp      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}
