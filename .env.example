# ==============================================================================
# SKILL SETU — ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=skill_setu_super_secret_jwt_key_2026_secure

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL connection string (Direct or Transaction Pooler):
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For zero-config local development without Supabase, SQLite is supported out of the box:
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTH & STORAGE (https://supabase.com)
# ------------------------------------------------------------------------------
# Retrieve from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Storage Bucket: Create a public bucket named "documents" for file uploads

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI API (AI Quiz Generation)
# ------------------------------------------------------------------------------
# Get your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH CREDENTIALS (Supabase Auth Google Provider)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
